---
// src/components/sections/contact/ContactCTA.astro
---

<section class="py-16 md:py-24 bg-gradient-hero relative overflow-hidden w-full">
  <!-- Efectos decorativos -->
  <div class="absolute inset-0 bg-gradient-glow opacity-20"></div>
  <div class="absolute top-0 left-0 w-full h-full">
    <div class="absolute top-10 right-10 w-72 h-72 bg-cyan-500/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-10 left-10 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl"></div>
  </div>

  <div class="container relative z-10">
    <div class="max-w-4xl mx-auto text-center">
      <span class="badge-cyan mb-6 inline-block">¿Listo para empezar?</span>
      <h2 class="font-display text-3xl md:text-4xl lg:text-5xl font-bold text-white leading-tight mb-6">
        Transforma tu negocio con
        <span class="text-gradient-accent">tecnología de vanguardia</span>
      </h2>
      <p class="text-lg text-gray-300 mb-8 max-w-2xl mx-auto">
        Cuéntanos tu proyecto y te ayudaremos a encontrar la mejor solución tecnológica para tus necesidades.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="#contact-form" class="btn-primary text-lg group inline-flex items-center">
          Contáctanos ahora
          <svg class="w-5 h-5 ml-2 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
        <a href="/services" class="btn-secondary text-lg">
          Ver nuestros servicios
        </a>
      </div>
    </div>
  </div>
</section>