---
// src/components/sections/contact/ContactInfo.astro
---

<section class="py-16 md:py-24 bg-brand-secondary w-full">
  <div class="container">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <!-- Email -->
      <div class="card-gradient p-6 text-center hover:shadow-glow-cyan transition-all duration-300 hover:-translate-y-1 group">
        <div class="w-14 h-14 bg-cyan-500/10 rounded-2xl flex items-center justify-center mx-auto mb-4 group-hover:bg-cyan-500/20 transition-colors">
          <svg class="w-7 h-7 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <h3 class="text-white font-semibold mb-2">Email</h3>
        <a href="mailto:hola@unysolutions.com" class="text-gray-400 hover:text-cyan-400 transition-colors text-sm">
          hola@unysolutions.com
        </a>
      </div>

      <!-- Teléfono -->
      <div class="card-gradient p-6 text-center hover:shadow-glow-cyan transition-all duration-300 hover:-translate-y-1 group">
        <div class="w-14 h-14 bg-cyan-500/10 rounded-2xl flex items-center justify-center mx-auto mb-4 group-hover:bg-cyan-500/20 transition-colors">
          <svg class="w-7 h-7 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
        </div>
        <h3 class="text-white font-semibold mb-2">Teléfono</h3>
        <a href="tel:+34900123456" class="text-gray-400 hover:text-cyan-400 transition-colors text-sm">
          +34 900 123 456
        </a>
      </div>

      <!-- Dirección -->
      <div class="card-gradient p-6 text-center hover:shadow-glow-cyan transition-all duration-300 hover:-translate-y-1 group">
        <div class="w-14 h-14 bg-cyan-500/10 rounded-2xl flex items-center justify-center mx-auto mb-4 group-hover:bg-cyan-500/20 transition-colors">
          <svg class="w-7 h-7 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <h3 class="text-white font-semibold mb-2">Dirección</h3>
        <p class="text-gray-400 text-sm">
          Calle Tecnología 123<br />
          Madrid, España 28001
        </p>
      </div>

      <!-- Horario -->
      <div class="card-gradient p-6 text-center hover:shadow-glow-cyan transition-all duration-300 hover:-translate-y-1 group">
        <div class="w-14 h-14 bg-cyan-500/10 rounded-2xl flex items-center justify-center mx-auto mb-4 group-hover:bg-cyan-500/20 transition-colors">
          <svg class="w-7 h-7 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="text-white font-semibold mb-2">Horario</h3>
        <p class="text-gray-400 text-sm">
          Lunes - Viernes<br />
          <span class="text-cyan-400">9:00 - 18:00</span>
        </p>
        <p class="text-gray-500 text-xs mt-2">Soporte 24/7 disponible</p>
      </div>
    </div>
  </div>
</section>