---
// src/components/sections/contact/ContactForm.astro
---

<section class="py-16 md:py-24 bg-brand-primary w-full">
  <div class="container">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
      <!-- Columna Izquierda: Información adicional -->
      <div class="space-y-8">
        <div>
          <span class="badge-cyan mb-4 inline-block">Envíanos un mensaje</span>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-white leading-tight mb-4">
            Hablemos sobre tu <span class="text-gradient-accent">próximo proyecto</span>
          </h2>
          <p class="text-gray-300 text-lg">
            Completa el formulario y nos pondremos en contacto contigo en menos de 24 horas.
          </p>
        </div>

        <!-- Beneficios -->
        <div class="space-y-4">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-cyan-500/10 rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <h4 class="text-white font-semibold">Respuesta rápida</h4>
              <p class="text-gray-400 text-sm">Te respondemos en menos de 24 horas</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-cyan-500/10 rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <div>
              <h4 class="text-white font-semibold">Asesoría sin compromiso</h4>
              <p class="text-gray-400 text-sm">Te ayudamos a definir la mejor solución</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-cyan-500/10 rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <div>
              <h4 class="text-white font-semibold">Soluciones personalizadas</h4>
              <p class="text-gray-400 text-sm">Adaptamos la tecnología a tus necesidades</p>
            </div>
          </div>
        </div>

        <!-- Redes Sociales -->
        <div>
          <p class="text-gray-400 text-sm mb-3">Síguenos en redes sociales</p>
          <div class="flex gap-3">
            <a href="#" class="w-12 h-12 bg-cyan-500/10 rounded-xl flex items-center justify-center hover:bg-cyan-500/20 transition-colors group">
              <svg class="w-6 h-6 text-gray-400 group-hover:text-cyan-400 transition-colors" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
            <a href="#" class="w-12 h-12 bg-cyan-500/10 rounded-xl flex items-center justify-center hover:bg-cyan-500/20 transition-colors group">
              <svg class="w-6 h-6 text-gray-400 group-hover:text-cyan-400 transition-colors" fill="currentColor" viewBox="0 0 24 24">
                <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.937 4.937 0 004.604 3.417 9.868 9.868 0 01-6.102 2.104c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 0021.875-11.798c0-.334-.007-.668-.024-.999A10.006 10.006 0 0024 4.557z"/>
              </svg>
            </a>
            <a href="#" class="w-12 h-12 bg-cyan-500/10 rounded-xl flex items-center justify-center hover:bg-cyan-500/20 transition-colors group">
              <svg class="w-6 h-6 text-gray-400 group-hover:text-cyan-400 transition-colors" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.15 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.62.24 2.85.12 3.15.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Columna Derecha: Formulario -->
      <div class="card-gradient p-6 md:p-8">
        <h3 class="text-white text-xl font-semibold mb-6">Envíanos un mensaje</h3>
        
        <form class="space-y-5" method="POST" action="/api/contact" data-netlify="true" data-netlify-honeypot="bot-field">
          <!-- Nombre -->
          <div>
            <label for="name" class="block text-gray-300 text-sm font-medium mb-2">
              Nombre completo *
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full bg-brand-primary/50 border border-cyan-500/20 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20 transition-all"
              placeholder="Tu nombre"
            />
          </div>

          <!-- Email -->
          <div>
            <label for="email" class="block text-gray-300 text-sm font-medium mb-2">
              Correo electrónico *
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full bg-brand-primary/50 border border-cyan-500/20 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20 transition-all"
              placeholder="tu@email.com"
            />
          </div>

          <!-- Teléfono -->
          <div>
            <label for="phone" class="block text-gray-300 text-sm font-medium mb-2">
              Teléfono
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              class="w-full bg-brand-primary/50 border border-cyan-500/20 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20 transition-all"
              placeholder="+34 900 123 456"
            />
          </div>

          <!-- Asunto -->
          <div>
            <label for="subject" class="block text-gray-300 text-sm font-medium mb-2">
              Asunto *
            </label>
            <select
              id="subject"
              name="subject"
              required
              class="w-full bg-brand-primary/50 border border-cyan-500/20 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20 transition-all appearance-none"
            >
              <option value="" class="bg-brand-secondary">Selecciona un asunto</option>
              <option value="web-development" class="bg-brand-secondary">Desarrollo Web</option>
              <option value="mobile-apps" class="bg-brand-secondary">Apps Móviles</option>
              <option value="cloud-solutions" class="bg-brand-secondary">Soluciones Cloud</option>
              <option value="ai-ml" class="bg-brand-secondary">IA & Machine Learning</option>
              <option value="ux-ui" class="bg-brand-secondary">UX/UI Design</option>
              <option value="consulting" class="bg-brand-secondary">Consultoría</option>
              <option value="other" class="bg-brand-secondary">Otro</option>
            </select>
          </div>

          <!-- Mensaje -->
          <div>
            <label for="message" class="block text-gray-300 text-sm font-medium mb-2">
              Mensaje *
            </label>
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              class="w-full bg-brand-primary/50 border border-cyan-500/20 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20 transition-all resize-none"
              placeholder="Cuéntanos sobre tu proyecto..."
            ></textarea>
          </div>

          <!-- Checkbox de privacidad -->
          <div class="flex items-start gap-3">
            <input
              type="checkbox"
              id="privacy"
              name="privacy"
              required
              class="mt-1 w-4 h-4 bg-brand-primary/50 border border-cyan-500/20 rounded focus:ring-cyan-500 focus:ring-2 focus:ring-offset-0 text-cyan-500 cursor-pointer"
            />
            <label for="privacy" class="text-gray-400 text-sm cursor-pointer">
              Acepto la <a href="/privacy" class="text-cyan-400 hover:text-cyan-300 transition-colors">política de privacidad</a> *
            </label>
          </div>

          <!-- Botón de envío -->
          <button
            type="submit"
            class="w-full btn-primary py-3 text-center group"
          >
            Enviar mensaje
            <svg class="inline-block w-5 h-5 ml-2 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </button>

          <p class="text-gray-500 text-xs text-center mt-4">
            * Campos obligatorios. Nos pondremos en contacto en menos de 24 horas.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>