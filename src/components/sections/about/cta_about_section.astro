---
// src/components/sections/about/AboutCTA.astro
---

<section class="py-16 md:py-24 bg-brand-secondary w-full">
  <div class="container">
    <div class="card-gradient p-8 md:p-12 text-center relative overflow-hidden">
      <!-- Efecto decorativo -->
      <div class="absolute inset-0 bg-gradient-glow opacity-10"></div>
      
      <div class="relative z-10">
        <span class="badge-cyan mb-4 inline-block">Trabaja con nosotros</span>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-white mb-4">
          ¿Listo para <span class="text-gradient-accent">transformar</span> tu negocio?
        </h2>
        <p class="text-gray-300 text-lg mb-8 max-w-2xl mx-auto">
          Únete a las empresas que ya confían en nosotros para impulsar su transformación digital.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/contact" class="btn-primary text-lg group inline-flex items-center">
            Contáctanos ahora
            <svg class="w-5 h-5 ml-2 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
          <a href="/services" class="btn-secondary text-lg">
            Ver nuestros servicios
          </a>
        </div>
      </div>
    </div>
  </div>
</section>