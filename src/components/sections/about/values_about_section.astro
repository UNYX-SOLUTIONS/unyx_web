---
// src/components/sections/about/AboutValues.astro
import { values } from '../../../data/values.js';
---

<section class="py-16 md:py-24 bg-brand-primary w-full">
  <div class="container">
    <!-- Encabezado -->
    <div class="text-center max-w-3xl mx-auto mb-12 md:mb-16">
      <span class="badge-cyan mb-4">Nuestros valores</span>
      <h2 class="font-display text-3xl md:text-4xl font-bold text-white mb-4">
        Lo que nos <span class="text-gradient-accent">define</span>
      </h2>
      <p class="text-gray-300 text-lg">
        Estos son los principios que guían cada decisión y cada proyecto que emprendemos.
      </p>
    </div>

    <!-- Grid de valores -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        values.map((value) => (
          <div class="card-gradient p-6 md:p-8 hover:shadow-glow-cyan transition-all duration-300 hover:-translate-y-1 group text-center">
            <div class="w-16 h-16 bg-cyan-500/10 rounded-2xl flex items-center justify-center mx-auto mb-4 group-hover:bg-cyan-500/20 transition-colors">
              <svg class="w-8 h-8 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="text-white text-xl font-semibold mb-2 group-hover:text-cyan-400 transition-colors">
              {value.title}
            </h3>
            <p class="text-gray-400 text-sm leading-relaxed">
              {value.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>