---
// src/components/sections/services/ServicesList.astro
import { services } from '../../../data/services.js';
---

<section class="py-16 md:py-24 bg-brand-secondary w-full">
  <div class="container">
    <!-- Encabezado -->
    <div class="text-center max-w-3xl mx-auto mb-12 md:mb-16">
      <span class="badge-cyan mb-4">Qué ofrecemos</span>
      <h2 class="font-display text-3xl md:text-4xl font-bold text-white mb-4">
        Servicios <span class="text-gradient-accent">especializados</span>
      </h2>
      <p class="text-gray-300 text-lg">
        Cada servicio está diseñado para resolver desafíos específicos y crear valor real para tu negocio.
      </p>
    </div>

    <!-- Grid de servicios -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-8">
      {
        services.map((service, index) => (
          <div class="card-gradient p-6 md:p-8 hover:shadow-glow-cyan transition-all duration-300 hover:-translate-y-1 group">
            <div class="flex items-start gap-4">
              <!-- Número -->
              <div class="text-4xl font-bold text-cyan-500/20 font-display shrink-0">
                {(index + 1).toString().padStart(2, '0')}
              </div>
              
              <div class="flex-1">
                <!-- Icono -->
                <div class="w-12 h-12 bg-cyan-500/10 rounded-xl flex items-center justify-center mb-4 group-hover:bg-cyan-500/20 transition-colors">
                  <svg class="w-6 h-6 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                </div>

                <!-- Título -->
                <h3 class="text-white text-xl font-semibold mb-2 group-hover:text-cyan-400 transition-colors">
                  {service.title}
                </h3>

                <!-- Descripción -->
                <p class="text-gray-400 text-sm mb-4">
                  {service.description}
                </p>

                <!-- Descripción completa -->
                <p class="text-gray-300 text-sm mb-4 border-l-2 border-cyan-500/30 pl-4">
                  {service.fullDescription}
                </p>

                <!-- Características -->
                <div class="mb-4">
                  <h4 class="text-cyan-400 text-sm font-semibold mb-2">Características:</h4>
                  <ul class="grid grid-cols-1 sm:grid-cols-2 gap-1.5">
                    {
                      service.features.slice(0, 4).map((feature) => (
                        <li class="text-gray-400 text-sm flex items-center gap-2">
                          <svg class="w-3.5 h-3.5 text-cyan-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                          </svg>
                          {feature}
                        </li>
                      ))
                    }
                  </ul>
                </div>

                <!-- Tecnologías -->
                <div class="flex flex-wrap gap-2 mb-4">
                  {
                    service.technologies.map((tech) => (
                      <span class="text-xs bg-cyan-500/10 text-cyan-400 px-2.5 py-1 rounded-full border border-cyan-500/20">
                        {tech}
                      </span>
                    ))
                  }
                </div>

                <!-- Precio y CTA -->
                <div class="flex items-center justify-between pt-4 border-t border-cyan-500/10">
                  <div>
                    <span class="text-gray-400 text-sm">Desde</span>
                    <span class="text-cyan-400 font-bold text-lg ml-1">{service.price}</span>
                  </div>
                  <a 
                    href={`/contact?service=${service.id}`} 
                    class="inline-flex items-center gap-1 text-cyan-400 hover:text-cyan-300 text-sm font-medium transition-colors group/link"
                  >
                    Solicitar presupuesto
                    <svg class="w-4 h-4 transition-transform group-hover/link:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>