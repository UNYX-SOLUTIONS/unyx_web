---
// src/components/sections/Services.astro
import { services } from '../../data/services.js';
---

<section class="py-16 md:py-24 bg-brand-secondary">
  <div class="container-custom">
    <!-- Encabezado -->
    <div class="text-center max-w-3xl mx-auto mb-12 md:mb-16">
      <span class="badge-cyan mb-4">Servicios</span>
      <h2 class="font-display text-3xl md:text-4xl font-bold text-white mb-4">
        Soluciones que <span class="text-gradient-accent">impulsan</span> tu negocio
      </h2>
      <p class="text-gray-300 text-lg">
        Ofrecemos servicios tecnológicos de vanguardia adaptados a las necesidades de tu empresa.
      </p>
    </div>

    <!-- Grid de servicios -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {
        services.map((service) => (
          <div class="card-gradient p-6 md:p-8 hover:shadow-glow-cyan transition-all duration-300 hover:-translate-y-1 group">
            <!-- Icono -->
            <div class="w-12 h-12 bg-cyan-500/10 rounded-xl flex items-center justify-center mb-4 group-hover:bg-cyan-500/20 transition-colors">
              <svg class="w-6 h-6 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>

            <!-- Título -->
            <h3 class="text-white text-xl font-semibold mb-2 group-hover:text-cyan-400 transition-colors">
              {service.title}
            </h3>

            <!-- Descripción -->
            <p class="text-gray-400 text-sm mb-4">
              {service.description}
            </p>

            <!-- Características -->
            <ul class="space-y-1.5">
              {
                service.features.map((feature) => (
                  <li class="text-gray-400 text-sm flex items-center gap-2">
                    <svg class="w-3.5 h-3.5 text-cyan-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                    {feature}
                  </li>
                ))
              }
            </ul>

            <!-- Enlace -->
            <a href={`/services/${service.id}`} class="inline-flex items-center gap-1 text-cyan-400 hover:text-cyan-300 text-sm font-medium mt-4 transition-colors">
              Saber más
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>