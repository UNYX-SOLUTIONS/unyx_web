---
// src/components/sections/hero_home_section.astro
---

<section
  class="hero-section bg-gradient-hero relative overflow-hidden h-screen"
>
  <!-- ✅ Imagen de fondo local -->
  <div class="absolute inset-0 z-0">
    <img
      src="/Capacitacion1.png"
      alt="Fondo tecnológico"
      class="w-full h-full object-cover opacity-30"
    />
  </div>

  <!-- Efectos decorativos de fondo -->
  <div class="absolute inset-0 bg-gradient-glow opacity-30 z-0"></div>
  <div
    class="absolute top-20 right-10 w-72 h-72 bg-cyan-500/5 rounded-full blur-3xl z-0"
  >
  </div>
  <div
    class="absolute bottom-20 left-10 w-96 h-96 bg-cyan-500/5 rounded-full blur-3xl z-0"
  >
  </div>

  <!-- ======================================================== -->
  <!-- REDES SOCIALES - IZQUIERDA (vertical)                    -->
  <!-- ======================================================== -->
  <div
    class="absolute left-8 top-1/2 -translate-y-1/2 z-20 flex flex-col gap-6"
  >
    <a
      href="https://linkedin.com"
      target="_blank"
      class="text-gray-400 hover:text-cyan-400 transition-colors duration-300 hover:scale-110 transform"
      aria-label="LinkedIn"
    >
      <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
        <path
          d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
        ></path>
      </svg>
    </a>
    <a
      href="https://twitter.com"
      target="_blank"
      class="text-gray-400 hover:text-cyan-400 transition-colors duration-300 hover:scale-110 transform"
      aria-label="Twitter"
    >
      <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
        <path
          d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
        ></path>
      </svg>
    </a>
    <a
      href="https://youtube.com"
      target="_blank"
      class="text-gray-400 hover:text-cyan-400 transition-colors duration-300 hover:scale-110 transform"
      aria-label="YouTube"
    >
      <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
        <path
          d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
        ></path>
      </svg>
    </a>
    <a
      href="https://github.com"
      target="_blank"
      class="text-gray-400 hover:text-cyan-400 transition-colors duration-300 hover:scale-110 transform"
      aria-label="GitHub"
    >
      <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
        <path
          d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.15 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.62.24 2.85.12 3.15.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"
        ></path>
      </svg>
    </a>
  </div>

  <!-- ======================================================== -->
  <!-- ICONOS DE INNOVACIÓN - DERECHA (vertical)                -->
  <!-- ======================================================== -->
  <div
    class="absolute right-8 top-1/2 -translate-y-1/2 z-20 flex flex-col gap-8"
  >
    <!-- IA / Innovación -->
    <div class="flex flex-col items-center gap-1 group cursor-pointer">
      <div
        class="w-12 h-12 rounded-full bg-cyan-500/10 flex items-center justify-center group-hover:bg-cyan-500/20 transition-all duration-300 group-hover:scale-110"
      >
        <svg
          class="w-6 h-6 text-cyan-400"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"
          ></path>
        </svg>
      </div>
      <span
        class="text-[10px] text-gray-400 font-medium uppercase tracking-wider"
        >IA</span
      >
    </div>

    <!-- Cloud / Nube -->
    <div class="flex flex-col items-center gap-1 group cursor-pointer">
      <div
        class="w-12 h-12 rounded-full bg-cyan-500/10 flex items-center justify-center group-hover:bg-cyan-500/20 transition-all duration-300 group-hover:scale-110"
      >
        <svg
          class="w-6 h-6 text-cyan-400"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"
          ></path>
        </svg>
      </div>
      <span
        class="text-[10px] text-gray-400 font-medium uppercase tracking-wider"
        >Cloud</span
      >
    </div>

    <!-- Cybersecurity / Seguridad -->
    <div class="flex flex-col items-center gap-1 group cursor-pointer">
      <div
        class="w-12 h-12 rounded-full bg-cyan-500/10 flex items-center justify-center group-hover:bg-cyan-500/20 transition-all duration-300 group-hover:scale-110"
      >
        <svg
          class="w-6 h-6 text-cyan-400"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
          ></path>
        </svg>
      </div>
      <span
        class="text-[10px] text-gray-400 font-medium uppercase tracking-wider"
        >Security</span
      >
    </div>

    <!-- DevOps / Integración -->
    <div class="flex flex-col items-center gap-1 group cursor-pointer">
      <div
        class="w-12 h-12 rounded-full bg-cyan-500/10 flex items-center justify-center group-hover:bg-cyan-500/20 transition-all duration-300 group-hover:scale-110"
      >
        <svg
          class="w-6 h-6 text-cyan-400"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"
          ></path>
        </svg>
      </div>
      <span
        class="text-[10px] text-gray-400 font-medium uppercase tracking-wider"
        >DevOps</span
      >
    </div>
  </div>

  <!-- ======================================================== -->
  <!-- CONTENIDO PRINCIPAL (se mantiene igual)                  -->
  <!-- ======================================================== -->
  <div
    class="relative z-10 container flex flex-col items-center! justify-center!"
  >
    <div
      class="max-w-5xl! flex flex-col items-center justify-center text-center gap-8"
    >
      <div
        class="max-w-3xl! flex flex-col items-center justify-center text-center gap-5 translate-y-0"
      >
        <div class="inline-flex items-center gap-2 mb-6 animate-fade-in">
          <span class="w-2 h-2 bg-cyan-500 rounded-full animate-pulse"></span>
          Bienvenido a Unyx Solutions
        </div>

        <!-- Título -->
        <h1
          class="font-display text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-semibold text-white leading-tight mb-6 animate-slide-up"
        >
          Integraciones y
          <span class="text-gradient-accent">soluciones</span>
          completas para tu empresa
        </h1>

        <div
          class="flex flex-wrap gap-4 animate-slide-up [animation-delay:400ms]"
        >
          <a
            href="#services"
            class="btn-primary text-base md:text-lg group p-2.5!"
          >
            Conocer más
            <svg
              class="inline-block w-5 h-5 ml-2 transition-transform group-hover:translate-x-1"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Tarjetas de servicios -->
      <div
        class="grid grid-cols-3 gap-8! h-full mx-auto w-full my-2! translate-y-15"
      >
        <!-- Bloque 1 -->
        <div
          class="bg-transparent p-2! flex flex-col gap-2! shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 text-start"
        >
          <p class="text-md leading-relaxed font-normal mb-3 text-gray-300">
            Transformamos tu infraestructura con soluciones escalables y seguras
          </p>
          <a
            href="#soluciones"
            class="inline-block text-base font-semibold text-blue-600 hover:text-blue-700 transition-all duration-200 hover:translate-x-1.5 border-b-2 border-transparent hover:border-blue-600 pb-0.5"
          >
            Conocer más —
          </a>
        </div>

        <!-- Bloque 2 -->
        <div
          class="bg-transparent p-2! flex flex-col gap-2! shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 text-start"
        >
          <p class="text-md leading-relaxed font-normal mb-3 text-gray-300">
            Automatización inteligente para optimizar tus procesos
          </p>
          <a
            href="#automatizacion"
            class="inline-block text-base font-semibold text-blue-600 hover:text-blue-700 transition-all duration-200 hover:translate-x-1.5 border-b-2 border-transparent hover:border-blue-600 pb-0.5"
          >
            Conocer más —
          </a>
        </div>

        <!-- Bloque 3 -->
        <div
          class="bg-transparent p-2! flex flex-col gap-2! shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 text-start"
        >
          <p class="text-md leading-relaxed font-normal mb-3 text-gray-300">
            Consultoría y asesoría en transformación digital
          </p>
          <a
            href="#consultoria"
            class="inline-block text-base font-semibold text-blue-600 hover:text-blue-700 transition-all duration-200 hover:translate-x-1.5 border-b-2 border-transparent hover:border-blue-600 pb-0.5"
          >
            Conocer más —
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
