---
// src/components/sections/About.astro
---

<section class="py-16 md:py-24 bg-brand-primary relative overflow-hidden w-full">
  <!-- Efectos decorativos -->
  <div class="absolute inset-0 bg-gradient-glow opacity-10"></div>
  <div class="absolute -top-40 -right-40 w-96 h-96 bg-cyan-500/5 rounded-full blur-3xl"></div>
  <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-cyan-500/5 rounded-full blur-3xl"></div>
  
  <div class="container relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Columna Izquierda: Contenido -->
      <div class="space-y-6">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 badge-cyan">
          <span class="w-2 h-2 bg-cyan-500 rounded-full animate-pulse"></span>
          Sobre nosotros
        </div>

        <!-- Título -->
        <h2 class="font-display text-3xl md:text-4xl lg:text-5xl font-bold text-white leading-tight">
          Impulsamos tu negocio con
          <span class="text-gradient-accent">tecnología</span>
          de primer nivel
        </h2>

        <!-- Descripción -->
        <div class="space-y-4 text-gray-300">
          <p class="text-lg leading-relaxed">
            En <span class="text-cyan-400 font-semibold">Unyx Solutions</span>, somos un equipo de expertos apasionados por la tecnología y la innovación. 
            Nos dedicamos a crear soluciones digitales que transforman negocios y mejoran la vida de las personas.
          </p>
          <p class="text-gray-400 leading-relaxed">
            Con más de <span class="text-cyan-400 font-semibold">5 años de experiencia</span> en el sector tecnológico, 
            hemos ayudado a más de <span class="text-cyan-400 font-semibold">50 empresas</span> a alcanzar sus objetivos 
            digitales con soluciones personalizadas y de vanguardia.
          </p>
        </div>

        <!-- Valores -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-cyan-500/10 rounded-lg flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <div>
              <p class="text-white text-sm font-medium">Confiabilidad</p>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-cyan-500/10 rounded-lg flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <div>
              <p class="text-white text-sm font-medium">Innovación</p>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-cyan-500/10 rounded-lg flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <div>
              <p class="text-white text-sm font-medium">Equipo</p>
            </div>
          </div>
        </div>

        <!-- Botón CTA -->
        <div class="pt-4">
          <a href="/about" class="btn-primary group inline-flex items-center">
            Conoce más sobre nosotros
            <svg class="w-5 h-5 ml-2 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Columna Derecha: Imagen/Estadísticas -->
      <div class="space-y-6">
        <!-- Imagen principal (placeholder) -->
        <div class="relative">
          <div class="card-gradient p-1 rounded-2xl overflow-hidden">
            <div class="bg-gradient-hero rounded-xl p-8 aspect-video flex items-center justify-center relative overflow-hidden">
              <!-- Efecto glow interno -->
              <div class="absolute inset-0 bg-gradient-glow opacity-20"></div>
              
              <!-- Contenido del placeholder -->
              <div class="relative z-10 text-center">
                <div class="w-20 h-20 mx-auto mb-4 bg-cyan-500/20 rounded-2xl flex items-center justify-center">
                  <svg class="w-10 h-10 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                  </svg>
                </div>
                <p class="text-white font-display text-lg font-semibold">Unyx Solutions</p>
                <p class="text-gray-400 text-sm">Innovación tecnológica</p>
              </div>
            </div>
          </div>
          
          <!-- Badge flotante -->
          <div class="absolute -bottom-4 -right-4 bg-cyan-500/10 backdrop-blur-custom border border-cyan-500/20 rounded-xl px-4 py-3">
            <div class="flex items-center gap-3">
              <div class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>
              <span class="text-white text-sm font-medium">+50 proyectos</span>
            </div>
          </div>
        </div>

        <!-- Estadísticas rápidas -->
        <div class="grid grid-cols-3 gap-4">
          <div class="card-gradient p-4 text-center">
            <div class="text-2xl font-bold text-cyan-400">5+</div>
            <div class="text-gray-400 text-xs">Años de experiencia</div>
          </div>
          <div class="card-gradient p-4 text-center">
            <div class="text-2xl font-bold text-cyan-400">50+</div>
            <div class="text-gray-400 text-xs">Proyectos completados</div>
          </div>
          <div class="card-gradient p-4 text-center">
            <div class="text-2xl font-bold text-cyan-400">98%</div>
            <div class="text-gray-400 text-xs">Satisfacción</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>