---
// src/components/sections/About.astro
---

<section
  class="py-16 md:py-24 bg-brand-primary relative overflow-hidden h-screen w-full"
>
  <div class="absolute inset-0 bg-gradient-glow opacity-5"></div>

  <div class="container relative z-10">
    <!-- Encabezado -->
    <div class="text-center max-w-6xl mx-auto mb-12">
      <!-- Badge superior -->
      <div class="flex justify-center mb-4">
        <span
          class="inline-flex items-center gap-2 text-xs font-medium tracking-wider uppercase"
          style="color: var(--color-accent);"
        >
          <span
            class="w-1.5 h-1.5 rounded-full"
            style="background: var(--color-accent);"></span>
          Sobre nosotros
        </span>
      </div>

      <!-- Línea + Título + Línea -->
      <div class="flex items-center justify-center gap-6">
        <!-- Línea izquierda -->
        <div
          class="hidden sm:block flex-1 max-w-80 h-px"
          style="background: linear-gradient(to right, transparent, var(--color-accent));"
        >
        </div>

        <h2
          class="font-display text-3xl md:text-4xl lg:text-5xl font-bold text-white leading-tight whitespace-nowrap"
        >
          Sobre
          <span class="text-gradient-accent">Unyx</span>
          Solutions
        </h2>

        <!-- Línea derecha -->
        <div
          class="hidden sm:block flex-1 max-w-80 h-px"
          style="background: linear-gradient(to left, transparent, var(--color-accent));"
        >
        </div>
      </div>
    </div>

    <!-- Pilares -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="text-start flex flex-col items-center gap-40 py-28!">
        <div class="max-w-md">
          <p class="text-gray-400 text-sm">
            Somos un equipo de expertos apasionados por la tecnología, dedicados
            a impulsar el crecimiento de tu negocio a través de soluciones
            innovadoras y personalizadas.
          </p>
        </div>
        <div class="max-w-md">
          <p class="text-gray-400 text-sm">
            Con años de experiencia en el sector, hemos ayudado a empresas de
            todos los tamaños a transformar sus operaciones y alcanzar sus
            objetivos.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
        <!-- Item 1: Osaka -->
        <div
          class="text-center p-6 rounded-2xl border border-cyan-500/10 bg-cyan-500/5 transition-all duration-300 hover:border-cyan-500/30 hover:bg-cyan-500/10 hover:-translate-y-1 group"
        >
          <div class="flex justify-center mb-3">
            <div
              class="w-12 h-12 rounded-full bg-cyan-500/10 flex items-center justify-center group-hover:bg-cyan-500/20 transition-colors"
            >
              <svg
                class="w-6 h-6 text-cyan-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                ></path>
              </svg>
            </div>
          </div>
          <div
            class="text-sm font-medium tracking-wider uppercase"
            style="color: var(--color-accent);"
          >
            Days 1-3
          </div>
          <h3 class="text-2xl md:text-3xl font-bold text-white mt-2">Osaka</h3>
        </div>

        <!-- Item 2: Kyoto -->
        <div
          class="text-center p-6 rounded-2xl border border-cyan-500/10 bg-cyan-500/5 transition-all duration-300 hover:border-cyan-500/30 hover:bg-cyan-500/10 hover:-translate-y-1 group"
        >
          <div class="flex justify-center mb-3">
            <div
              class="w-12 h-12 rounded-full bg-cyan-500/10 flex items-center justify-center group-hover:bg-cyan-500/20 transition-colors"
            >
              <svg
                class="w-6 h-6 text-cyan-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                ></path>
              </svg>
            </div>
          </div>
          <div
            class="text-sm font-medium tracking-wider uppercase"
            style="color: var(--color-accent);"
          >
            Days 4-6
          </div>
          <h3 class="text-2xl md:text-3xl font-bold text-white mt-2">Kyoto</h3>
        </div>

        <!-- Item 3: Tokyo -->
        <div
          class="text-center p-6 rounded-2xl border border-cyan-500/10 bg-cyan-500/5 transition-all duration-300 hover:border-cyan-500/30 hover:bg-cyan-500/10 hover:-translate-y-1 group"
        >
          <div class="flex justify-center mb-3">
            <div
              class="w-12 h-12 rounded-full bg-cyan-500/10 flex items-center justify-center group-hover:bg-cyan-500/20 transition-colors"
            >
              <svg
                class="w-6 h-6 text-cyan-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M8.288 15.038a5.25 5.25 0 017.424 0M5.106 11.856c-1.587 1.387-2.606 2.762-2.606 4.144 0 1.383 1.02 2.756 2.606 4.144M18.894 11.856c1.587 1.387 2.606 2.762 2.606 4.144 0 1.383-1.02 2.756-2.606 4.144M12 14.25a2.25 2.25 0 110 4.5 2.25 2.25 0 010-4.5z"
                ></path>
              </svg>
            </div>
          </div>
          <div
            class="text-sm font-medium tracking-wider uppercase"
            style="color: var(--color-accent);"
          >
            Days 7-10
          </div>
          <h3 class="text-2xl md:text-3xl font-bold text-white mt-2">Tokyo</h3>
        </div>
      </div>

      <!-- CTA -->
      <div class="text-center mt-12 pt-8 border-t border-cyan-500/10">
        <a
          href="/about"
          class="inline-flex items-center gap-2 text-cyan-400 hover:text-cyan-300 font-medium transition-colors group"
        >
          Conoce más sobre nosotros
          <svg
            class="w-4 h-4 transition-transform group-hover:translate-x-1"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
