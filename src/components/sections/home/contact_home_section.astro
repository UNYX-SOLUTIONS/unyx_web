---
// src/components/sections/Contact.astro
---

<section
  class="py-16! md:py-24! bg-brand-primary relative overflow-hidden w-full"
>
  <!-- ✅ Imagen de fondo -->
  <div class="absolute inset-0 z-0">
    <img
      src="servicio7.png"
      alt="Contacto Unyx Solutions"
      class="w-full h-full object-cover opacity-20"
    />
  </div>

  <!-- Efecto de grid futurista -->
  <div
    class="absolute inset-0 z-0 opacity-5"
    style="background-image: 
    linear-gradient(rgba(35, 169, 189, 0.1) 1px, transparent 1px),
    linear-gradient(90deg, rgba(35, 169, 189, 0.1) 1px, transparent 1px);
    background-size: 60px 60px;"
  >
  </div>

  <!-- Efecto de glow circular futurista -->
  <div
    class="absolute top-1/4 left-1/4 w-96 h-96 rounded-full blur-3xl z-0"
    style="background: radial-gradient(circle, rgba(35, 169, 189, 0.15), transparent 70%);"
  >
  </div>
  <div
    class="absolute bottom-1/4 right-1/4 w-96 h-96 rounded-full blur-3xl z-0"
    style="background: radial-gradient(circle, rgba(35, 169, 189, 0.1), transparent 70%);"
  >
  </div>

  <!-- Efectos decorativos existentes -->
  <div class="absolute inset-0 bg-gradient-glow opacity-5 z-0"></div>
  <div
    class="absolute -top-40 -right-40 w-96! h-96! bg-cyan-500/5 rounded-full blur-3xl z-0"
  >
  </div>
  <div
    class="absolute -bottom-40 -left-40 w-96! h-96! bg-cyan-500/5 rounded-full blur-3xl z-0"
  >
  </div>

  <div class="container relative z-10">
    <!-- Encabezado -->
    <!-- Encabezado -->
    <div class="text-center mb-12!">
      <!-- Línea + Título + Línea -->
      <div class="flex items-center justify-center gap-6">
        <!-- Línea izquierda -->
        <div
          class="hidden sm:block flex-1 max-w-80 h-px"
          style="background: linear-gradient(to right, transparent, var(--color-accent));"
        >
        </div>

        <h2
          class="font-display text-3xl md:text-4xl lg:text-5xl font-bold text-white leading-tight whitespace-nowrap"
        >
          ¿Listo para <span class="text-gradient-accent">transformar</span> tu negocio?
        </h2>

        <!-- Línea derecha -->
        <div
          class="hidden sm:block flex-1 max-w-80 h-px"
          style="background: linear-gradient(to left, transparent, var(--color-accent));"
        >
        </div>
      </div>
    </div>

    <!-- Grid: Información + Formulario -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12! lg:gap-16!">
      <!-- Columna Izquierda: Información de contacto -->
      <div class="space-y-8! flex flex-col justify-center">
        <h3 class="text-white text-xl! font-semibold!">Ponte en contacto</h3>
        <p class="text-gray-400! text-sm! leading-relaxed!">
          ¿Tienes preguntas o estás listo para transformar tu negocio con
          tecnología de vanguardia? Escríbenos y te responderemos a la brevedad.
        </p>

        <!-- Email -->
        <div class="flex items-start gap-4 group">
          <div
            class="w-10! h-10! rounded-xl flex items-center justify-center shrink-0"
            style="background: var(--color-accent-glow);"
          >
            <svg
              class="w-5! h-5!"
              style="color: var(--color-accent);"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
          </div>
          <div>
            <p class="text-gray-400 text-xs! uppercase tracking-wider">Email</p>
            <a
              href="mailto:hola@unysolutions.com"
              class="text-white hover:text-cyan-400 transition-colors text-sm"
            >
              hola@unysolutions.com
            </a>
          </div>
        </div>

        <!-- Teléfono -->
        <div class="flex items-start gap-4 group">
          <div
            class="w-10! h-10! rounded-xl flex items-center justify-center shrink-0"
            style="background: var(--color-accent-glow);"
          >
            <svg
              class="w-5! h-5!"
              style="color: var(--color-accent);"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              ></path>
            </svg>
          </div>
          <div>
            <p class="text-gray-400 text-xs uppercase tracking-wider">
              Teléfono
            </p>
            <a
              href="tel:+34900123456"
              class="text-white hover:text-cyan-400 transition-colors text-sm"
            >
              +34 900 123 456
            </a>
          </div>
        </div>

        <!-- Ubicación -->
        <div class="flex items-start gap-4 group">
          <div
            class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0"
            style="background: var(--color-accent-glow);"
          >
            <svg
              class="w-5 h-5"
              style="color: var(--color-accent);"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              ></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <div>
            <p class="text-gray-400 text-xs uppercase tracking-wider">
              Ubicación
            </p>
            <p class="text-white text-sm">
              Calle Tecnología 123, Madrid, España
            </p>
          </div>
        </div>
      </div>

      <!-- Columna Derecha: Formulario -->
      <div
        class="rounded-2xl p-6! md:p-8! border border-cyan-500/10 backdrop-blur-sm!"
        style="background: rgba(10, 22, 40, 0.7);"
      >
        <h3 class="text-white text-xl! font-semibold mb-6">
          Envíanos un mensaje
        </h3>

        <form class="space-y-4!" method="POST" action="/api/contact">
          <!-- Nombre -->
          <div>
            <label
              for="name"
              class="block text-gray-300 text-sm font-medium mb-2!"
            >
              Nombre
            </label>
            <input
              type="text"
              id="name"
              name="name"
              class="w-full rounded-lg px-4! py-3! text-white placeholder-gray-500 focus:outline-none focus:ring-2 transition-all text-sm"
              style="background: var(--color-brand-primary); border: 1px solid rgba(35, 169, 189, 0.15); focus:ring: var(--color-accent);"
              placeholder="Tu nombre"
            />
          </div>

          <!-- Email -->
          <div>
            <label
              for="email"
              class="block text-gray-300 text-sm font-medium mb-2!"
            >
              Correo electrónico
            </label>
            <input
              type="email"
              id="email"
              name="email"
              class="w-full rounded-lg px-4! py-3! text-white placeholder-gray-500 focus:outline-none focus:ring-2 transition-all text-sm"
              style="background: var(--color-brand-primary); border: 1px solid rgba(35, 169, 189, 0.15); focus:ring: var(--color-accent);"
              placeholder="tu@email.com"
            />
          </div>

          <!-- Mensaje -->
          <div class="text-start!">
            <label
              for="message"
              class="block text-gray-300 text-sm! font-medium mb-2!"
            >
              Mensaje
            </label>
            <textarea
              id="message"
              name="message"
              rows="4"
              class="w-full rounded-lg px-4! py-3! text-white placeholder-gray-500 focus:outline-none focus:ring-2 transition-all text-sm resize-none"
              style="background: var(--color-brand-primary); border: 1px solid rgba(35, 169, 189, 0.15); focus:ring: var(--color-accent);"
              placeholder="Cuéntanos sobre tu proyecto..."></textarea>
          </div>

          <!-- Botón Submit -->
          <button
            type="submit"
            class="w-full btn-primary text-center! group inline-flex items-center justify-center gap-2! py-3!"
          >
            Enviar mensaje
            <svg
              class="w-4! h-4! transition-transform duration-300 group-hover:translate-x-1"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
