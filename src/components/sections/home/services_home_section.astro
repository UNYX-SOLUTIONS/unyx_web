---
// src/components/sections/Services.astro
import { services } from '../../../data/services.js';
---

<section class="py-16! md:py-24! bg-brand-secondary relative overflow-hidden w-full">
  <div class="absolute inset-0 bg-gradient-glow opacity-5"></div>
  
  <div class="container relative z-10">
    <!-- Encabezado -->
    <div class="mb-14! text-center flex flex-col justify-center items-center gap-2">
      <h2 class="font-display text-2xl md:text-3xl lg:text-4xl font-bold text-white leading-tight">
        Soluciones que <span class="text-gradient-accent">impulsan</span> tu negocio
      </h2>
      <p class="text-gray-400 text-sm">
        Descubre cómo nuestras soluciones tecnológicas pueden transformar tu empresa.
      </p>
    </div>

    <!-- Grid de servicios -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        services.map((service) => (
          <div class="group relative rounded-2xl overflow-hidden aspect-[4/3] transition-all duration-500 hover:scale-[1.02] hover:shadow-glow-cyan">
            <!-- Imagen de fondo con efecto zoom -->
            <div class="absolute inset-0">
              <img 
                src={service.image} 
                alt={service.title} 
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
              />
            </div>

            <!-- Overlay oscuro en la parte inferior -->
            <div class="absolute inset-0 bg-gradient-to-t from-gray-950 via-gray-950/60 to-transparent opacity-80 group-hover:opacity-90 transition-opacity duration-500"></div>

            <!-- Badge de categoría -->
            <div class="absolute top-4 left-4 px-3 py-1 rounded-full text-xs font-medium bg-cyan-500/20 backdrop-blur-sm border border-cyan-500/30 text-cyan-400">
              {service.category || 'Tecnología'}
            </div>

            <!-- Contenido -->
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <h3 class="text-white text-xl font-semibold mb-1 group-hover:text-cyan-400 transition-colors">
                {service.title}
              </h3>
              <p class="text-gray-300 text-sm line-clamp-2">
                {service.description}
              </p>
              <div class="mt-3 opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
                <a href={`/services/${service.id}`} class="inline-flex items-center gap-1.5 text-sm font-medium text-cyan-400 hover:text-cyan-300 transition-colors">
                  Saber más
                  <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Ver todos -->
    <div class="text-center mt-12">
      <a href="/services" class="inline-flex items-center gap-2 text-sm font-medium transition-all duration-300 hover:gap-3 text-cyan-400 hover:text-cyan-300">
        Ver todos los servicios
        <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>