---
// src/components/layout/Header.astro
import { navigation } from "../../data/navigation";
import Navbar from "./navbar.astro"; // Importamos el componente React
---

<header
  class="relative w-full top-0 left-0 right-0 z-50 shadow-lg pt-3.5 pb-3 text-gray-300"
>
  <!-- Fondo con degradado elegante -->
  <div
    class="absolute inset-0 bg-linear-to-t from-gray-950 via-gray-950 to-gray-950"
  >
  </div>

  <!-- Efecto de brillo sutil -->
  <div
    class="absolute inset-0 bg-linear-to-b from-cyan-500/5 via-transparent to-transparent"
  >
  </div>

  <!-- Borde inferior con efecto "lucesita" -->
  <div
    class="absolute z-50 bottom-0 left-0 right-0 h-px bg-linear-to-r from-transparent via-cyan-500/30 to-transparent"
  >
  </div>

  <!-- Contenido -->
  <div class="relative z-10 container">
    <div class="flex items-center justify-between h-16 md:h-20">
      <!-- Logo -->
      <a
        href="/"
        class="flex items-center gap-2 group shrink-0 transition-all duration-300 hover:scale-105 relative z-40"
      >
        <div
          class="absolute -inset-1 bg-linear-to-r from-cyan-500/20 to-blue-500/20 rounded-lg blur-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300"
        >
        </div>
        <img
          src="/logo.png"
          alt="Unyx Solutions"
          class="w-10 h-10 md:w-15 md:h-15 lg:w-20 lg:h-20 relative z-10 brightness-110 drop-shadow-md transition-transform duration-300 group-hover:scale-110"
        />
      </a>

      <!-- ✅ Navbar centrado -->
      <div class="hidden md:block">
        <Navbar />
      </div>

      <!-- Acciones (Contáctanos y menú móvil) -->
      <div class="flex items-center gap-4 md:gap-6 z-40">
        <a
          href="/contact"
          class="hidden md:inline-flex items-center gap-2 px-4! py-2! rounded-lg bg-gray-800/80 backdrop-blur-sm hover:bg-cyan-500 hover:text-gray-900 text-sm font-medium transition-all duration-200 hover:scale-105 shadow-md"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            ></path>
          </svg>
          <span>Contáctanos</span>
        </a>

        <!-- El botón de menú móvil ahora lo maneja Navbar2, así que lo quitamos de aquí -->
        <!-- Pero si quieres mantenerlo como respaldo, puedes dejarlo comentado -->
      </div>
    </div>
  </div>
</header>
