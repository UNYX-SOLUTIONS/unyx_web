---
// src/components/layout/Header.astro
import { navigation } from '../../data/navigation';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-brand-primary/90 backdrop-blur-custom border-b border-cyan-500/10">
  <div class="container">
    <div class="flex items-center justify-between h-16 md:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 group shrink-0">
        <!-- ✅ Imagen SVG -->
        <img 
          src="/logo.png" 
          alt="Unyx Solutions" 
          class="w-10 h-10 md:w-15 md:h-15 lg:w-20 lg:h-20 transition-transform duration-300 group-hover:scale-110"
        />
      </a>

      <!-- Navegación Desktop -->
      <nav class="hidden md:flex items-center gap-8">
        {
          navigation.map((item) => (
            <a
              href={item.href}
              class="text-gray-300 hover:text-cyan-400 transition-colors relative group text-sm font-medium"
            >
              {item.label}
              <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-cyan-500 transition-all group-hover:w-full"></span>
            </a>
          ))
        }
      </nav>

      <!-- Acciones -->
      <div class="flex items-center gap-4">
        <a 
          href="/contact" 
          class="hidden md:block btn-primary text-sm py-2.5 px-5"
        >
          Contáctanos
        </a>
        
        <!-- Mobile Menu Button -->
        <button 
          class="md:hidden text-white hover:text-cyan-400 transition-colors p-2"
          aria-label="Abrir menú"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>