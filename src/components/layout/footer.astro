---
// src/components/layout/Footer.astro
import { navigation } from "../../data/navigation.js";
---

<footer
  class="bg-brand-secondary border-t border-cyan-500/10 relative overflow-hidden"
>
  <!-- Efecto decorativo sutil -->
  <div class="absolute inset-0 bg-gradient-glow opacity-5"></div>

  <div class="container relative z-10">
    <div class="py-12! md:py-16!">
      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 md:gap-12"
      >
        <!-- Columna 1: Logo y descripción -->
        <div class="lg:col-span-1">
          <a href="/" class="inline-block mb-4 group">
            <!-- ✅ Logo con imagen SVG -->
            <img
              src="/logo.png"
              alt="Unyx Solutions"
              class="w-10 h-10 md:w-15 md:h-15 lg:w-20 lg:h-20 transition-transform duration-300 group-hover:scale-110"
            />
          </a>
          <p class="text-gray-400 text-sm leading-relaxed max-w-sm mt-2">
            Soluciones tecnológicas innovadoras para impulsar el crecimiento de
            tu negocio en la era digital.
          </p>
          <div class="flex gap-4 mt-4">
            <!-- LinkedIn -->
            <a
              href="#"
              class="text-gray-400 hover:text-cyan-400 transition-colors"
              aria-label="LinkedIn"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path
                  d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                ></path>
              </svg>
            </a>
            <!-- Twitter/X -->
            <a
              href="#"
              class="text-gray-400 hover:text-cyan-400 transition-colors"
              aria-label="Twitter"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path
                  d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.937 4.937 0 004.604 3.417 9.868 9.868 0 01-6.102 2.104c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 0021.875-11.798c0-.334-.007-.668-.024-.999A10.006 10.006 0 0024 4.557z"
                ></path>
              </svg>
            </a>
            <!-- GitHub -->
            <a
              href="#"
              class="text-gray-400 hover:text-cyan-400 transition-colors"
              aria-label="GitHub"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path
                  d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.15 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.62.24 2.85.12 3.15.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"
                ></path>
              </svg>
            </a>
          </div>
        </div>

        <!-- Columna 2: Empresa -->
        <div>
          <h3
            class="text-white font-semibold text-sm uppercase tracking-wider mb-4"
          >
            Empresa
          </h3>
          <ul class="space-y-2.5">
            <li>
              <a
                href="/about"
                class="text-gray-400 hover:text-cyan-400 transition-colors text-sm"
              >
                Sobre Nosotros
              </a>
            </li>
            <li>
              <a
                href="/services"
                class="text-gray-400 hover:text-cyan-400 transition-colors text-sm"
              >
                Servicios
              </a>
            </li>
            <li>
              <a
                href="/contact"
                class="text-gray-400 hover:text-cyan-400 transition-colors text-sm"
              >
                Contacto
              </a>
            </li>
          </ul>
        </div>

        <!-- Columna 3: Servicios -->
        <div>
          <h3
            class="text-white font-semibold text-sm uppercase tracking-wider mb-4"
          >
            Servicios
          </h3>
          <ul class="space-y-2.5">
            <li>
              <a
                href="/services/web-development"
                class="text-gray-400 hover:text-cyan-400 transition-colors text-sm"
              >
                Desarrollo Web
              </a>
            </li>
            <li>
              <a
                href="/services/mobile-apps"
                class="text-gray-400 hover:text-cyan-400 transition-colors text-sm"
              >
                Apps Móviles
              </a>
            </li>
            <li>
              <a
                href="/services/cloud-solutions"
                class="text-gray-400 hover:text-cyan-400 transition-colors text-sm"
              >
                Soluciones Cloud
              </a>
            </li>
            <li>
              <a
                href="/services/ai-ml"
                class="text-gray-400 hover:text-cyan-400 transition-colors text-sm"
              >
                IA & Machine Learning
              </a>
            </li>
          </ul>
        </div>

        <!-- Columna 4: Contacto -->
        <div>
          <h3
            class="text-white font-semibold text-sm uppercase tracking-wider mb-4"
          >
            Contacto
          </h3>
          <ul class="space-y-3">
            <li class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-cyan-400 shrink-0 mt-0.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
              <span class="text-gray-400 text-sm">hola@unysolutions.com</span>
            </li>
            <li class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-cyan-400 shrink-0 mt-0.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                ></path>
              </svg>
              <span class="text-gray-400 text-sm">+34 900 123 456</span>
            </li>
            <li class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-cyan-400 shrink-0 mt-0.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                ></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              <span class="text-gray-400 text-sm">Madrid, España</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Copyright -->
      <div class="mt-12 pt-8 border-t border-cyan-500/10 text-center">
        <p class="text-gray-500 text-sm">
          &copy; {new Date().getFullYear()} Uny Solutions. Todos los derechos reservados.
        </p>
      </div>
    </div>
  </div>
</footer>
