---
// src/pages/404.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada">
  <div class="min-h-screen flex items-center justify-center bg-gradient-hero">
    <div class="text-center max-w-2xl mx-auto px-4">
      <!-- Número de error -->
      <div class="text-8xl md:text-9xl font-bold text-cyan-500/20 font-display mb-4">
        404
      </div>
      
      <!-- Título -->
      <h1 class="font-display text-3xl md:text-4xl font-bold text-white mb-4">
        Página no encontrada
      </h1>
      
      <!-- Descripción -->
      <p class="text-gray-300 text-lg mb-8">
        Lo sentimos, la página que buscas no existe o ha sido movida.
      </p>
      
      <!-- Botón de regreso -->
      <a href="/" class="btn-primary inline-flex items-center group">
        <svg class="w-5 h-5 mr-2 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Volver al inicio
      </a>
    </div>
  </div>
</Layout>